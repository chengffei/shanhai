,"born":"1929年","died":"2022年","how":"birth"},{"q":"Q271850","name":"阿格西莱二世","desc":"","born":"公元前443年","died":"公元前359年","how":"birth"},{"q":"Q328793","name":"佩里安德","desc":"","born":"公元前700年","died":"公元前584年","how":"birth"},{"q":"Q296698","name":"科斯塔·加夫拉斯","desc":"希腊裔法国导演","born":"1933年","died":"","how":"birth"},{"q":"Q34601","name":"契罗","desc":"","born":"公元前599年","died":"公元前519年","how":"birth"},{"q":"Q192222","name":"留西波斯","desc":"","born":"公元前389年","died":"公元前299年","how":"birth"},{"q":"Q193422","name":"波留克列特斯","desc":"","born":"公元前489年","died":"公元前419年","how":"birth"},{"q":"Q143559","name":"吕山德","desc":"古希腊军事家","born":"公元前401年","died":"公元前394年","how":"birth"}],"events":[{"q":"Q675181","name":"伊斯特米亚竞技大会","desc":"","year":"公元前581年"},{"q":"Q527006","name":"尼米亚竞技大会","desc":"","year":"公元前572年"},{"q":"Q176416","name":"斯法克特里亚之战","desc":"","year":"公元前424年"},{"q":"Q670128","name":"派娄斯之战","desc":"","year":"公元前424年"},{"q":"Q1362053","name":"曼提尼亚战役","desc":"","year":"公元前417年"},{"q":"Q233399","name":"曼丁尼亚战役","desc":"","year":"公元前361年"},{"q":"Q1474893","name":"克里昂米尼战争","desc":"","year":"公元前228年"},{"q":"Q587983","name":"科林斯战役","desc":"","year":"公元前145年"},{"q":"Q2351714","name":"佐奇奥战役","desc":"","year":"1499年"},{"q":"Q238440","name":"纳瓦里诺海战","desc":"","year":"1827年"}]},"1182":{"desc":"希腊的大区","facts":{"capital":"帕特雷","population":648220,"populationYear":"2021","area":11350},"wiki":"西希腊大区","summary":"西希腊大区（希腊语：Περιφέρεια Δυτικής Ελλάδας，罗马化：Periféria Dhitikís Elládhas），是希腊的13个大区之一，位于中希腊传统地区的西部和伯罗奔尼撒半岛的西北部。大区面积为11,350平方公里，2021年人口数量为648,220人。大区首府为帕特雷，为希腊第三大城市，人口数量约为280,000人。","people":[{"q":"Q188983","name":"吉尔吉奥斯·卡拉古尼斯","desc":"希腊足球运动员","born":"1977年","died":"","how":"birth"},{"q":"Q192313","name":"皮浪","desc":"","born":"公元前360年","died":"公元前270年","how":"birth"},{"q":"Q206421","name":"科斯蒂斯·斯特凡诺普洛斯","desc":"希腊总统","born":"1926年","died":"2016年","how":"birth"},{"q":"Q156505","name":"乔治斯·帕帕佐普洛斯","desc":"","born":"1919年","died":"1999年","how":"birth"},{"q":"Q211124","name":"科斯塔斯·卡楚拉尼斯","desc":"希腊足球运动员","born":"1979年","died":"","how":"birth"},{"q":"Q210573","name":"希庇亚","desc":"","born":"公元前442年","died":"公元前398年","how":"birth"},{"q":"Q311207","name":"乔治奥斯·帕潘德里欧","desc":"","born":"1888年","died":"1968年","how":"birth"},{"q":"Q317967","name":"科斯蒂斯·帕拉马斯","desc":"","born":"1859年","died":"1943年","how":"birth"},{"q":"Q4755614","name":"安德烈斯·萨马里斯","desc":"希腊职业足球员","born":"1989年","died":"","how":"birth"},{"q":"Q332096","name":"亚历山德罗斯·泽米斯","desc":"","born":"1855年","died":"1936年","how":"birth"},{"q":"Q380190","name":"埃利斯的斐多","desc":"","born":"公元前401年","died":"公元前400年","how":"birth"}],"events":[{"q":"Q650567","name":"土耳其人一年的包围","desc":"","year":"1825年"}]},"1183":{"desc":"希腊的大区","facts":{"capital":"科扎尼","population":254595,"populationYear":"2021","area":9451},"wiki":"西马其顿大区","summary":"西马其顿大区（希腊语：Δυτική Μακεδονία，罗马化：Ditiki Makedonia），是希腊的13个大区之一，位于希腊西北部，覆盖希腊马其顿地区的西部。大区面积为9,451平方公里，人口数量约为25.5万人。大区首府设在科扎尼。","history":{"title":"历史","text":"该区域属于古代马其顿王国的西部边陲，同时受到伊庇鲁斯文化影响。罗马时代归属马其顿行省；拜占庭时期，这里是抵御北方部族入侵的边疆地带，留存大量拜占庭修道院与堡垒遗址。奥斯曼帝国统治时期，本地山区形成半自治的山区社群。\n巴尔干战争结束，1913年该地区并入希腊王国。20世纪经历人口交换、二战、希腊内战，边境地带社会变动剧烈。弗洛里纳周边长期存在斯拉夫语少数族群。"},"culture":{"title":"文化与古迹","text":"卡斯托里亚老城：湖畔拜占庭古城，数十座中世纪拜占庭教堂，保存大量壁画。\n普雷斯帕国家公园：跨国湖泊湿地，世界自然保护地。\n众多山区拜占庭修道院、中世纪堡垒遗迹。"},"people":[{"q":"Q200401","name":"安提柯一世","desc":"贵族，将军，国王","born":"公元前381年","died":"公元前300年","how":"birth"},{"q":"Q202113","name":"佩尔狄卡斯","desc":"","born":"公元前364年","died":"公元前320年","how":"birth"},{"q":"Q235111","name":"武拉·帕图利祖","desc":"","born":"1965年","died":"","how":"birth"},{"q":"Q318563","name":"伊安尼斯·阿马纳蒂迪斯","desc":"希腊足球运动员","born":"1981年","died":"","how":"birth"},{"q":"Q321642","name":"彭迪利斯·卡比达路斯","desc":"希腊足球运动员","born":"1983年","died":"","how":"birth"},{"q":"Q457994","name":"保萨尼亚斯","desc":"","born":"公元前400年","died":"公元前335年","how":"birth"},{"q":"Q531408","name":"科奇·佐治","desc":"阿尔巴尼亚政治人物","born":"1911年","died":"1949年","how":"birth"},{"q":"Q2092187","name":"迪米塔尔·布拉戈耶夫","desc":"保加利亚政治人物","born":"1856年","died":"1924年","how":"birth"},{"q":"Q2305326","name":"帕特罗纳·哈利勒","desc":"","born":"1690年","died":"1730年","how":"birth"}],"events":[{"q":"Q763428","name":"佩拉戈尼亚战役","desc":"","year":"1259年"}]},"1184":{"desc":"希腊的传统地理区域","facts":{"population":722065,"populationYear":"2018","area":14037},"wiki":"色薩利","summary":"色萨利（希腊语：Θεσσαλία，罗马化：Thessalía）是希腊的一个地理区域，位于希腊中部，范围大致与行政区色萨利大区吻合。色萨利地区的最大城市为拉里萨，人口有164,095人。\n色萨利位于品都斯山脉东麓，东边是皮利翁山形成的一个半岛，呈现盆地地形。东南方的帕加西蒂科斯湾是色萨利进出爱琴海的通道，海港城市沃洛斯位在海湾北岸。著名的奥林匹斯山座落于色萨利北部，与马其顿之间的分界。皮尼奥斯河由西向东流过色萨利北部。","people":[{"q":"Q153172","name":"范吉利斯","desc":"希腊音乐家（1943—2022）","born":"1943年","died":"2022年","how":"birth"},{"q":"Q156622","name":"乔治欧·德·奇里诃","desc":"意大利超现实主义艺术家","born":"1888年","died":"1978年","how":"birth"},{"q":"Q201885","name":"塞奥法尼斯·耶卡斯","desc":"希腊足球运动员","born":"1980年","died":"","how":"birth"},{"q":"Q319684","name":"里加斯·费雷奥斯","desc":"希腊哲学家","born":"1757年","died":"1798年","how":"birth"},{"q":"Q208430","name":"索迪里奥斯·卡治亚高斯","desc":"希腊足球运动员","born":"1979年","died":"","how":"birth"},{"q":"Q237867","name":"阿格莱奥妮丝","desc":"","born":"","died":"","how":"birth"},{"q":"Q275691","name":"康斯坦丁诺斯·查尔基亚斯","desc":"希腊足球运动员","born":"1974年","died":"","how":"birth"},{"q":"Q241386","name":"安提柯二世","desc":"","born":"公元前318年","died":"公元前239年","how":"birth"},{"q":"Q313822","name":"科斯塔斯·福图尼斯","desc":"希腊足球运动员","born":"1992年","died":"","how":"birth"},{"q":"Q365110","name":"费隆","desc":"","born":"公元前158年","died":"公元前83年","how":"birth"},{"q":"Q349883","name":"万杰利斯·莫拉斯","desc":"","born":"1981年","died":"","how":"birth"}],"events":[{"q":"Q1429804","name":"克兰农战役","desc":"","year":"公元前321年"},{"q":"Q391087","name":"库诺斯克法莱战役","desc":"","year":"公元前196年"},{"q":"Q203681","name":"法萨卢斯战役","desc":"","year":"公元前47年"},{"q":"Q2064142","name":"阿尔米洛斯战役","desc":"","year":"1311年"},{"q":"Q116946502","name":"2023年色萨利火车相撞事故","desc":"希腊交通事故","year":"2023年"}]},"1185":{"desc":"希腊的大区","facts":{"capital":"约阿尼纳","population":319991,"populationYear":"2021","area":9203},"wiki":"伊庇鲁斯大区","summary":"伊庇鲁斯大区（希腊语：Ήπειρος，罗马化：Ípiros）是希腊的一个传统地理区域及现今的大区之一。位于希腊西北部，北边与阿尔巴尼亚接壤，东边与西马其顿大区和色萨利大区比邻，南边与西希腊大区接壤，西部临伊奥尼亚海。大区总面积9203平方公里，人口数量为319,543人（2021年）。该大区是更为广阔的伊庇鲁斯历史地区的一部分，此历史地区横跨当今的阿尔巴尼亚和希腊两国，但大部分位于希腊境内。","people":[{"q":"Q101090","name":"教宗义禄","desc":"天主教会第13任教宗","born":"","died":"185年","how":"birth"},{"q":"Q57303","name":"卡罗洛斯·帕普利亚斯","desc":"希腊政治人物 (1929-2021)","born":"1929年","died":"2021年","how":"birth"},{"q":"Q223134","name":"奥林匹亚丝","desc":"","born":"公元前374年","died":"公元前315年","how":"birth"},{"q":"Q511943","name":"帕尔加勒·易卜拉欣帕夏","desc":"","born":"1495年","died":"1536年","how":"birth"},{"q":"Q20995518","name":"康斯坦丁诺斯·塔苏拉斯","desc":"希腊政治人物","born":"1959年","died":"","how":"birth"},{"q":"Q221138","name":"安托尼奥斯·尼科波利迪斯","desc":"","born":"1971年","died":"","how":"birth"},{"q":"Q68359","name":"雅典纳哥拉一世","desc":"","born":"1886年","died":"1972年","how":"birth"},{"q":"Q335658","name":"亚历山大一世","desc":"","born":"公元前361年","died":"公元前330年","how":"birth"},{"q":"Q717119","name":"约安尼斯·科莱提斯","desc":"","born":"1773年","died":"1847年","how":"birth"}],"events":[{"q":"Q1054975","name":"普雷韦扎海战","desc":"","year":"1538年"}]},"1186":{"desc":"希腊的大区","facts":{"capital":"米蒂利尼","population":194943,"populationYear":"2021","area":3836},"wiki":"北愛琴大區","summary":"北爱琴大区（希腊语：Περιφέρεια Βορείου Αιγαίου，罗马化：Perifereia Boreiou Aigaiou），是希腊13个大区之一，首府为米蒂利尼。面积3,836平方公里，人口数量为194,136人，为人口最少的大区。北爱琴大区包括了北爱琴海诸岛的绝大多数岛屿，除了萨索斯岛、萨莫色雷斯岛（隶属于东马其顿和色雷斯大区）以及格克切岛、博兹贾岛（隶属于土耳其恰纳卡莱省）。","people":[{"q":"Q10261","name":"毕达哥拉斯","desc":"古希腊哲学家、数学家","born":"公元前582年","died":"公元前490年","how":"birth"},{"q":"Q26825","name":"希罗多德","desc":"古希腊历史学家","born":"公元前483年","died":"公元前424年","how":"work"},{"q":"Q43423","name":"伊索","desc":"相传为《伊索寓言》的作者","born":"公元前619年","died":"公元前563年","how":"birth"},{"q":"Q17892","name":"莎孚","desc":"","born":"公元前650年","died":"公元前569年","how":"birth"},{"q":"Q43216","name":"伊壁鸠鲁","desc":"哲学家","born":"公元前341年","died":"公元前269年","how":"birth"},{"q":"Q160362","name":"泰奥弗拉斯托斯","desc":"","born":"公元前370年","died":"公元前286年","how":"birth"},{"q":"Q200582","name":"巴巴罗萨·海雷丁帕夏","desc":"","born":"1478年","died":"1546年","how":"birth"},{"q":"Q140188","name":"阿里斯塔克斯","desc":"","born":"公元前309年","died":"公元前229年","how":"birth"},{"q":"Q212872","name":"阿尔卡埃乌斯","desc":"","born":"公元前630年","died":"","how":"birth"},{"q":"Q151976","name":"米基斯·塞奥佐拉基斯","desc":"","born":"1925年","died":"2021年","how":"birth"},{"q":"Q311835","name":"庇塔库斯","desc":"","born":"公元前650年","died":"公元前570年","how":"birth"},{"q":"Q219256","name":"安德烈亚斯·乔治乌·帕潘德里欧","desc":"","born":"1919年","died":"1996年","how":"birth"}],"events":[{"q":"Q926514","name":"萨米安战争","desc":"","year":"公元前439年"},{"q":"Q1144988","name":"希俄斯大屠杀","desc":"","year":"1822年"},{"q":"Q328499","name":"穆德洛斯停战协定","desc":"","year":"1918年"}]},"1187":{"desc":"希腊的大区","facts":{"capital":"拉米亚","population":508254,"populationYear":"2021","area":15549},"wiki":"中希臘大區","summary":"中希腊大区（希腊语：Περιφέρεια Στερεάς Ελλάδας，罗马化：Periféreia Stereás Elládas）是希腊的13个大区之一。该大区占据中希腊传统地区的东半部，包括埃维亚岛。大区首府为拉米亚。面积15,549平方公里，人口数量为505,269人（2021年）。","people":[{"q":"Q868","name":"亚里士多德","desc":"古典希腊哲学家，柏拉图学生和西方哲学的创始人","born":"公元前383年","died":"公元前321年","how":"work"},{"q":"Q7235","name":"索福克勒斯","desc":"古希腊剧作家","born":"公元前495年","died":"公元前405年","how":"work"},{"q":"Q26825","name":"希罗多德","desc":"古希腊历史学家","born":"公元前483年","died":"公元前424年","how":"work"},{"q":"Q41523","name":"普鲁塔克","desc":"","born":"40年","died":"120年","how":"birth"},{"q":"Q125551","name":"巴门尼德","desc":"古希腊哲学家","born":"公元前514年","died":"公元前469年","how":"work"},{"q":"Q127385","name":"教宗西斯笃二世","desc":"天主教会第24任教宗","born":"215年","died":"258年","how":"birth"},{"q":"Q161775","name":"圣斯德望","desc":"古罗马圣徒","born":"1年","died":"36年","how":"birth"},{"q":"Q190436","name":"伊巴密浓达","desc":"","born":"公元前417年","died":"公元前361年","how":"birth"},{"q":"Q212499","name":"让-莱昂·热罗姆","desc":"法国画家（1824－1904）","born":"1824年","died":"1904年","how":"work"},{"q":"Q217128","name":"瓦连京·谢罗夫","desc":"画家","born":"1865年","died":"1911年","how":"work"},{"q":"Q192211","name":"米隆","desc":"公元前5世纪雅典雕塑家","born":"公元前500年","died":"公元前500年","how":"work"},{"q":"Q221142","name":"安杰洛斯·巴西纳斯","desc":"希腊足球运动员","born":"1976年","died":"","how":"birth"}],"events":[{"q":"Q649128","name":"皮媞亚竞技大会","desc":"","year":"公元前589年"},{"q":"Q131969","name":"温泉关战役","desc":"波希战争的战役","year":"公元前479年"},{"q":"Q747679","name":"阿提密西安海战","desc":"","year":"公元前479年"},{"q":"Q930550","name":"科罗尼亚之战","desc":"","year":"公元前446年"},{"q":"Q1424844","name":"德林亩之战","desc":"","year":"公元前423年"},{"q":"Q733113","name":"喀罗尼亚战役","desc":"","year":"公元前393年"},{"q":"Q461599","name":"留克特拉战役","desc":"","year":"公元前370年"},{"q":"Q200716","name":"喀罗尼亚战役","desc":"","year":"公元前337年"},{"q":"Q783058","name":"温泉关战役","desc":"","year":"公元前190年"},{"q":"Q2888837","name":"希腊战役","desc":"","year":"1941年"}]},"1188":{"desc":"希腊岛屿","facts":{"capital":"伊拉克利翁","population":623065,"populationYear":"2011","area":8336},"wiki":"克里特岛","summary":"克里特岛（希腊语：Κρήτη，罗马化：Kriti / Crete；古希腊语：Κρήτη，罗马化：Krḗtē；土耳其语：Girit；圣书体：𓎡𓆑𓍘𓅱𓈉，转写：keftiu），旧译革哩底，圣经中又称迦斐托（古希伯来文：כפתור，转写：caphtor），位于地中海北部，是希腊第一大岛，地中海第五大岛，东西长244公里，最宽处56公里，总面积8,300平方公里。行政上属于克里特大区，中部为高山，最高峰海拔为2740米，南部山势陡峻，特别是西南部，全为峭壁，难以开辟公路，北部较平缓，居民多集中北岸。岛上主要为地中海气候。\n克里特岛拥有漫长的文明史，是希腊乃至西方文明的源头。古时林木茂盛，农产丰富，人民善于航海和贸易，据荷马史诗所记说，“在深红葡萄酒色的海中，是一片美丽，富庶的土地，四面环水，岛上的人多得数不清，城市有九十个”。岛屿地处埃及、希腊、意大利及腓尼基之间，自古为战略要冲和贸易重镇，岛上有弥诺斯王宫等遗迹。","history":{"title":"历史","text":"克里特是最古老的欧洲文明“米诺斯文明”的中心。这种文明的起源几乎无人了解。该文明留下的文字记录并不多，而且它们使用的是一种称作“线性文字A”的文字，如今的人们已经无法解读。不过，该文明留下了大量精美的宫殿、房屋、道路、绘画以及雕塑。尽管早期克里特历史只留在荷马史诗之类的神话故事中（如米诺斯、忒修斯、阿里阿德涅、弥诺陶洛斯、代达洛斯和伊卡洛斯的神话故事），史学家和诗人似乎传达给我们了人类在克里特岛上定居的悠久历史。最早的定居点可追溯到无陶新石器时代，人们养殖牛、羊、猪、狗等动物，并种植谷物、豆角等作物。\n公元前1450年左右，克里特岛的宫殿遭到人为破坏，可能是由于巴尔干半岛希腊人（多利安人）的入侵。从这时起希腊人成了克里特岛的主宰，并逐渐与当地原有居民融合，克里特文明亦随之结束。"},"people":[{"q":"Q301","name":"埃尔·格列柯","desc":"","born":"1541年","died":"1614年","how":"birth"},{"q":"Q214622","name":"尼可斯·卡赞扎基斯","desc":"","born":"1883年","died":"1957年","how":"birth"},{"q":"Q160478","name":"奥季塞乌斯·埃利蒂斯","desc":"希腊诗人，诺贝尔文学奖获得者","born":"1911年","died":"1996年","how":"birth"},{"q":"Q154662","name":"娜娜·穆斯库莉","desc":"","born":"1934年","died":"","how":"birth"},{"q":"Q205545","name":"埃莱夫塞里奥斯·韦尼泽洛斯","desc":"希腊首相","born":"1864年","died":"1936年","how":"birth"},{"q":"Q202404","name":"佐治奥斯·森马拉斯","desc":"希腊足球运动员","born":"1985年","died":"","how":"birth"},{"q":"Q262884","name":"历山五世","desc":"","born":"1339年","died":"1410年","how":"birth"},{"q":"Q312013","name":"康斯坦丁·米佐塔基斯","desc":"希腊总理","born":"1918年","died":"2017年","how":"birth"},{"q":"Q320136","name":"提多","desc":"","born":"13年","died":"107年","how":"birth"},{"q":"Q314467","name":"埃奈西德穆","desc":"","born":"公元前79年","died":"公元前9年","how":"birth"},{"q":"Q320132","name":"尼阿卡斯","desc":"","born":"公元前355年","died":"公元前299年","how":"birth"},{"q":"Q64048","name":"亚历山大港希腊正教会","desc":"","born":"1954年","died":"","how":"birth"}],"events":[{"q":"Q701094","name":"坎迪亚围城战","desc":"","year":"1648年"},{"q":"Q153316","name":"克里特岛战役","desc":"","year":"1941年"}]},"1189":{"desc":"希腊的大区","facts":{"capital":"塞萨洛尼基","population":1795669,"populationYear":"2021","area":18811},"wiki":"中马其顿大区","summary":"中马其顿大区（希腊语：Περιφέρεια Κεντρικής Μακεδονίας，罗马化：Perifereia Kentrikis Makedonias），是希腊的13个大区之一，其范围覆盖希腊的马其顿传统地区的中部。大区面积为18,810.52平方公里，人口数量为1,795,669人（2021年）。大区首府为塞萨洛尼基。","history":{"title":"历史","text":"该地区是古代马其顿王国的核心故土。佩拉（派拉专区境内）是古代马其顿王国的首都，亚历山大大帝的出生地；韦里亚（贝罗亚）、迪翁均为古典时代重要城邦。罗马时期此地归入马其顿行省；拜占庭时代，塞萨洛尼基是帝国巴尔干地区最重要的都市。\n14世纪以后区域逐步被奥斯曼帝国统治，塞萨洛尼基成为奥斯曼巴尔干的商贸重镇。巴尔干战争结束后的1913年，这片土地正式归入希腊版图。20世纪经历人口交换、第二次世界大战、希腊内战，塑造了今日的人口与社会格局。"},"culture":{"title":"文化与古迹","text":"知名历史遗迹：\n派拉：古马其顿王国首都，亚历山大大帝出生地，大型考古遗址；\n迪翁：奥林匹斯山下古代圣城；\n塞萨洛尼基老城：大量拜占庭教堂，列入世界文化遗产；\n韦里亚（贝罗亚）古罗马‑拜占庭遗址；\n哈尔基季基半岛的古代城邦遗址；\n奥林匹斯山国家公园。"},"people":[{"q":"Q868","name":"亚里士多德","desc":"古典希腊哲学家，柏拉图学生和西方哲学的创始人","born":"公元前383年","died":"公元前321年","how":"birth"},{"q":"Q8409","name":"亚历山大大帝","desc":"前336年至前323年马其顿国王","born":"公元前355年","died":"公元前322年","how":"birth"},{"q":"Q5152","name":"穆斯塔法·凯末尔·阿塔图尔克","desc":"土耳其国父（1881年—1938年）","born":"1881年","died":"1938年","how":"birth"},{"q":"Q168261","name":"托勒密一世","desc":"","born":"公元前365年","died":"公元前285年","how":"birth"},{"q":"Q184906","name":"纳欣·希克美","desc":"","born":"1901年","died":"1963年","how":"birth"},{"q":"Q57415743","name":"卡特里娜·萨克拉罗普卢","desc":"希腊政治人物","born":"1956年","died":"","how":"birth"},{"q":"Q184176","name":"塞琉古一世","desc":"亚历山大将军","born":"公元前357年","died":"公元前280年","how":"birth"},{"q":"Q52166","name":"费德鲁斯","desc":"","born":"公元前20年","died":"50年","how":"birth"},{"q":"Q156806","name":"康斯坦丁诺斯·卡拉曼利斯","desc":"希腊首相","born":"1907年","died":"1998年","how":"birth"},{"q":"Q211488","name":"安条克一世","desc":"","born":"公元前323年","died":"公元前261年","how":"birth"},{"q":"Q109417","name":"安杰洛斯·查理斯特亚斯","desc":"希腊足球运动员","born":"1980年","died":"","how":"birth"},{"q":"Q32133","name":"利西马科斯","desc":"","born":"公元前360年","died":"公元前280年","how":"birth"}],"events":[{"q":"Q1356189","name":"波提达亚之战","desc":"","year":"公元前431年"},{"q":"Q504739","name":"彼得那战役","desc":"","year":"公元前167年"},{"q":"Q2617894","name":"彼得那战役 (前148年)","desc":"","year":"公元前147年"},{"q":"Q1155064","name":"帖撒罗尼卡屠杀","desc":"","year":"390年"},{"q":"Q1109261","name":"劫掠塞萨洛尼基","desc":"","year":"904年"},{"q":"Q2426040","name":"塞萨洛尼基之围","desc":"","year":"1422年"},{"q":"Q506916","name":"多布罗峰战役","desc":"","year":"1918年"}]},"1190":{"desc":"希腊的行政区划","facts":{"area":33042},"wiki":"阿索斯山","summary":"阿索斯山（希腊语：Άθως，[ˈa.θos]）为希腊东北部圣山半岛的一座山与东正教会修行制度的重要中心，在希腊国内是一个自治政体。阿索斯山共有20处修道院，直接由君士坦丁堡普世牧首区管辖。\n阿索斯山在希腊语中被称为“圣山”（Άγιον Όρος），其政治实体被称为“阿索斯政体”（Αθωνική Πολιτεία）。传统上东正教的其他语言也将该名称翻译为“圣山”（如保加利亚语及塞尔维亚语的Света гора、俄语的Святая Гора、格鲁吉亚语的მთაწმინდა）。在古典时期，圣山半岛称作阿克蒂半岛（Ακτή）。\n阿索斯山自古以来就有人居住，以近1,800年的基督教传统和悠久的修道历史传统而闻名，其历史可回溯到至少800年前与拜占庭时期。今日，来自希腊与包括罗马尼亚、摩尔多瓦、格鲁吉亚、保加利亚、塞尔维亚及俄罗斯等东正教国家在内的多个国家共2,000多名僧侣，在阿索斯山过着苦行生活，与世界其他地区处于隔离状态。","history":{"title":"历史","text":"在希腊神话中，阿索斯是在巨人与天神的战争时巨人族的一员。阿索斯将一块巨大的石头丢向海神波塞顿，使他跌入爱琴海，变成了圣山半岛。根据另一个版本，波塞顿用此山埋葬战败的巨人。\n古希腊历史学家希罗多德记述从利姆诺斯岛上来的皮拉斯基族人移民至此半岛，当时称作Acte或Akte（Herodotus, VII:22）。斯特拉波纪录半岛上的五个城市：Dion (Dium), Cleonae (Kleonai), Thyssos (Thyssus), Olophyxos (Olophyxis), Acrothoï (Akrothoön), of which the last is near the crest. (《地理学》, VII:33:1 ,斯特拉波) Eretria 亦于 Acte 建立了殖民地。"},"culture":{"title":"阿索斯山的文化及生活","text":"这些修道院的建筑结构和修道士的住所（cloisters）由一群建筑包围着中庭的连续高大建筑组成。这些建筑也具有保护盾的功用，使得圣山半岛的修道院有着独特形似城堡的外观。建筑中亦有开着枪眼的高塔。基于防御的理由，入口通常为隧道状，被厚重的覆铁木门紧闭。在靠近主要入口的外侧, 通常有个视野良好的宽敞小亭（kiosk）。修道院最重要的部分是靠近中央的内部中庭，中间的教堂称作“katholikon”，相对的西侧餐厅则称作“trapeza”。其他修道院的基础部分是会堂（Assembly room）和办公室（administration offices）、宾馆、修士的住处、图书馆、圣器收藏室。在大教堂西侧的入口有着“Fiali”, 盛着圣水的装饰华丽的大理石盥洗台。在中庭内有着清水的喷泉。小礼拜堂散布在修道院的各个地方。"},"people":[],"events":[]},"1191":{"desc":"希腊的大区","facts":{"capital":"科莫蒂尼","population":562201,"populationYear":"2021","area":14158},"wiki":"东马其顿和色雷斯大区","summary":"东马其顿和色雷斯大区（希腊语：Περιφέρεια Ανατολικής Μακεδονίας και Θράκης）是希腊的13个大区之一，位于希腊东北部，由马其顿历史区域的东部、西色雷斯地区，以及萨索斯岛和萨莫色雷斯岛组成。区府为科莫蒂尼。大区面积为14,158平方公里，2021年人口数量为562,069人。","history":{"title":"历史","text":"这片区域历史上长期处于各大帝国交替控制。古代色雷斯人与马其顿部族在此活动；先后被马其顿王国、罗马帝国、拜占庭帝国统治；中世纪保加利亚帝国亦多次入主此地。14 世纪起逐步被奥斯曼帝国征服，在此统治近五百年。\n巴尔干战争之后，1912‑1913年，东马其顿归入希腊；第一次世界大战结束之后，根据《讷伊条约》，西色雷斯划归希腊。两次世界大战期间，该地区边境多次动荡。第二次世界大战与希腊内战之后，大量希腊裔自土耳其迁入本区，同时本地保有规模可观的穆斯林少数族群，主要集中于克桑西、科莫蒂尼周边。"},"culture":{"title":"文化与古迹","text":"重要历史遗存包括：萨莫色雷斯岛的圣所考古遗址；菲利普城古遗址（靠近今日卡瓦拉）；境内保留大量拜占庭时期教堂、要塞；奥斯曼时代的清真寺、桥梁建筑，集中在科莫蒂尼、克桑西老城区。"},"people":[{"q":"Q41980","name":"德谟克利特","desc":"古希腊自然哲学家，原子论者","born":"公元前460年","died":"公元前360年","how":"birth"},{"q":"Q169243","name":"普罗泰戈拉","desc":"古希腊哲学家","born":"公元前489年","died":"公元前419年","how":"birth"},{"q":"Q201776","name":"华斯利斯·托路斯迪斯","desc":"希腊足球运动员（Vasilis Torosidis）","born":"1985年","died":"","how":"birth"},{"q":"Q311789","name":"易卜拉欣帕夏","desc":"","born":"1789年","died":"1848年","how":"birth"},{"q":"Q312534","name":"科斯塔斯·米特罗格卢","desc":"希腊足球运动员","born":"1988年","died":"","how":"birth"},{"q":"Q296452","name":"萨哥拉基斯","desc":"","born":"1971年","died":"","how":"birth"},{"q":"Q312114","name":"萨莫色雷斯的阿里斯塔库斯","desc":"","born":"公元前216年","died":"公元前143年","how":"birth"},{"q":"Q235494","name":"希帕嘉","desc":"","born":"公元前349年","died":"公元前279年","how":"birth"},{"q":"Q232650","name":"赫丽索皮伊·德韦齐","desc":"","born":"1975年","died":"","how":"birth"},{"q":"Q312036","name":"伊安尼斯·费特法季齐斯","desc":"希腊足球运动员","born":"1990年","died":"","how":"birth"},{"q":"Q182855","name":"波里格诺托斯","desc":"","born":"公元前500年","died":"公元前500年","how":"birth"},{"q":"Q366031","name":"阿那克萨图斯（阿布德拉）","desc":"","born":"公元前379年","died":"公元前319年","how":"birth"}],"events":[{"q":"Q637544","name":"安菲波利斯战役","desc":"","year":"公元前421年"},{"q":"Q335330","name":"腓立比战役","desc":"罗马内战的战役","year":"公元前41年"}]},"1192":{"desc":"希腊的大区","facts":{"capital":"埃尔穆波利","population":327820,"populationYear":"2021","area":5286},"wiki":"南愛琴大區","summary":"南爱琴大区 （希腊语：Περιφέρεια Νοτίου Αιγαίου，罗马化：Perifereia Notiou Aigaiou），是希腊13个大区之一，位于爱琴海中部和西南部，由基克拉泽斯群岛和佐泽卡尼索斯群岛组成。大区首府为锡罗斯岛上的埃尔穆波利，面积为5,286平方公里，人口数量为324,542人（2021年）。","people":[{"q":"Q5264","name":"希波克拉底","desc":"古希腊医师","born":"公元前459年","died":"公元前369年","how":"birth"},{"q":"Q219484","name":"忒奥克里托斯","desc":"公元前三世纪的古希腊诗人","born":"公元前400年","died":"公元前259年","how":"birth"},{"q":"Q39576","name":"托勒密二世","desc":"托勒密埃及的第二位法老和国王","born":"公元前307年","died":"公元前245年","how":"birth"},{"q":"Q201323","name":"阿尔基罗库斯","desc":"","born":"公元前687年","died":"公元前644年","how":"birth"},{"q":"Q273003","name":"西莫尼德斯","desc":"","born":"公元前555年","died":"公元前468年","how":"birth"},{"q":"Q61127","name":"柯塞姆苏丹","desc":"","born":"1589年","died":"1651年","how":"birth"},{"q":"Q39602","name":"托勒密三世","desc":"","born":"公元前283年","died":"公元前221年","how":"birth"},{"q":"Q238091","name":"努尔巴努苏丹","desc":"","born":"1525年","died":"1583年","how":"birth"},{"q":"Q297024","name":"泽麦特里乌斯·维凯拉斯","desc":"","born":"1835年","died":"1908年","how":"birth"},{"q":"Q310681","name":"巴库利德斯","desc":"","born":"公元前515年","died":"公元前450年","how":"birth"},{"q":"Q365950","name":"林度斯的克莱俄布卢","desc":"","born":"公元前629年","died":"公元前559年","how":"birth"},{"q":"Q297420","name":"班纳杜斯","desc":"","born":"公元前184年","died":"公元前110年","how":"birth"}],"events":[{"q":"Q641164","name":"围攻纳克索斯","desc":"","year":"公元前498年"},{"q":"Q2889436","name":"米洛斯围城战","desc":"","year":"公元前414年"},{"q":"Q648993","name":"罗得围城战","desc":"","year":"公元前304年"},{"q":"Q3235767","name":"科斯岛战役","desc":"","year":"公元前260年"},{"q":"Q701067","name":"罗德岛包围战","desc":"","year":"1480年"},{"q":"Q767935","name":"罗德岛之围","desc":"奥斯曼帝国在欧洲发动的战争的一部分","year":"1522年"}]}}}