name":"彼得·图克森","desc":"","born":"1948年","died":"","how":"birth"},{"q":"Q336916","name":"阿贝迪·贝利","desc":"加纳足球运动员","born":"1964年","died":"","how":"birth"},{"q":"Q350168","name":"萨穆埃尔·因科姆","desc":"","born":"1989年","died":"","how":"birth"},{"q":"Q595486","name":"安东尼·威廉·阿莫","desc":"","born":"1700年","died":"1759年","how":"birth"}],"events":[]},"1120":{"desc":"administrative region in Ghana","facts":{"capital":"阿克拉","population":5455692,"populationYear":"2021","area":3245},"wiki":"大阿克拉大區","summary":"大阿克拉大区（英语：Greater Accra Region）是加纳的16个大区之一，位于该国东南部，首府阿克拉，下分16县，北临东部大区，东北面是沃尔特大区，南接几内亚湾，西面是中部大区，面积3,245平方公里，2021年人口5,455,692人。","people":[{"q":"Q50678","name":"约翰·德拉马尼·马哈马","desc":"加纳总统","born":"1958年","died":"","how":"work"},{"q":"Q718601","name":"纳纳·阿库福-阿多","desc":"","born":"1944年","died":"","how":"birth"},{"q":"Q51008","name":"约翰·阿塔·米尔斯","desc":"加纳总统","born":"1944年","died":"2012年","how":"work"},{"q":"Q969520","name":"迈克尔·埃辛","desc":"加纳足球运动员","born":"1982年","died":"","how":"birth"},{"q":"Q51005","name":"约翰·阿吉耶库姆·库福尔","desc":"加纳第2任总统","born":"1938年","died":"","how":"work"},{"q":"Q193625","name":"马塞尔·德塞利","desc":"法国足球运动员","born":"1968年","died":"","how":"birth"},{"q":"Q222746","name":"阿萨莫阿·吉安","desc":"加纳足球运动员","born":"1985年","died":"","how":"birth"},{"q":"Q51002","name":"杰瑞·罗林斯","desc":"加纳第四共和国第1任总统","born":"1947年","died":"2020年","how":"birth"},{"q":"Q298466","name":"夸杜沃·阿萨莫阿","desc":"","born":"1988年","died":"","how":"birth"},{"q":"Q336916","name":"阿贝迪·贝利","desc":"加纳足球运动员","born":"1964年","died":"","how":"birth"},{"q":"Q211151","name":"史蒂芬·艾比亚","desc":"","born":"1980年","died":"","how":"birth"},{"q":"Q56877051","name":"库杜斯","desc":"","born":"2000年","died":"","how":"birth"}],"events":[{"q":"Q258301","name":"1963年非洲国家杯","desc":"","year":"1963年"}]},"1121":{"desc":"administrative region in Ghana","facts":{"capital":"霍城","population":1878316,"populationYear":"2009","area":20570},"wiki":"沃爾特大區","summary":"沃尔特大区（英语：Volta Region）是加纳的16个大区之一，位于该国东南部，首府霍城，下分18县，北临奥蒂大区，东接多哥，南临几内亚湾，西南与大阿克拉大区接壤，西临东部大区与东博诺大区，面积9,504平方公里，2010年人口2,118,252人。奥蒂大区原属此大区北部之一部分，惟于2018年加纳新大区公民投票结果而划出新设。\n原为德意志帝国殖民地，1884年归属德意志帝国的多哥兰管辖。1916年8月26日，英军入侵多哥兰，德国投降，多哥兰西部归英代管，是为“英属多哥兰”。1920年，国际联盟承认英国对多哥兰的占领，并把其列为国际联盟委任管治国，委任英国管治西多哥兰。而从这段时间开始，英国把英属多哥兰与原来的殖民地一起管理，是为英属黄金海岸。1956年12月并入加纳。","people":[{"q":"Q921435","name":"艾伍诺","desc":"","born":"1935年","died":"2013年","how":"birth"},{"q":"Q1323876","name":"艾尔·安纳祖","desc":"","born":"1944年","died":"","how":"birth"}],"events":[]}}}