":"birth"}],"events":[]},"1427":{"desc":"爱尔兰的郡","facts":{"capital":"莱伊什港","population":67012,"populationYear":"2016","area":1720},"wiki":"萊伊什郡","summary":"莱伊什郡（County Laois；爱尔兰语：Contae Laoise），是爱尔兰的一个郡，位于爱尔兰岛中部，巴罗河和诺尔河上游。历史上属伦斯特省。\n面积1,719平方公里，2006年人口69,012人。首府莱伊什港。","people":[{"q":"Q20089050","name":"Jacksepticeye","desc":"","born":"1990年","died":"","how":"birth"},{"q":"Q315855","name":"罗伯特·席安","desc":"","born":"1988年","died":"","how":"birth"},{"q":"Q954383","name":"塞希尔·戴-路易斯","desc":"","born":"1904年","died":"1972年","how":"birth"},{"q":"Q313694","name":"史堤芬·亨特","desc":"","born":"1981年","died":"","how":"birth"},{"q":"Q46779","name":"威洛比·汉密尔顿 (1864年生)","desc":"羽毛球运动员","born":"1864年","died":"1943年","how":"birth"}],"events":[]},"1428":{"desc":"愛爾蘭的郡","facts":{"capital":"克郎莫尔、尼纳","population":158652,"populationYear":"2011","area":4305},"wiki":"蒂珀雷里郡","summary":"蒂珀雷里郡（英语：County Tipperary；爱尔兰语：Contae Thiobraid Árann），俗称Premier County，是爱尔兰的一个郡，位于爱尔兰岛南部。\n历史上属芒斯特省。1898年分为南北两郡。2014年两郡归一。\n面积4,303 km²，2006年人口149,040人。","people":[{"q":"Q81520","name":"皮尔斯·布鲁斯南","desc":"美国演员","born":"1953年","died":"","how":"work"},{"q":"Q129987","name":"威廉三世","desc":"","born":"1650年","died":"1702年","how":"work"},{"q":"Q168362","name":"约翰·贝尔那","desc":"","born":"1901年","died":"1971年","how":"birth"},{"q":"Q272498","name":"布赖恩·博鲁","desc":"","born":"941年","died":"1014年","how":"birth"},{"q":"Q257625","name":"凯瑞·康顿","desc":"演员","born":"1983年","died":"","how":"birth"},{"q":"Q260543","name":"哈拉尔四世","desc":"挪威国王","born":"1102年","died":"1136年","how":"birth"},{"q":"Q55429","name":"吉姆·谢里登","desc":"爱尔兰电影导演","born":"1949年","died":"","how":"work"},{"q":"Q19362932","name":"莫莉·斯特灵","desc":"","born":"1998年","died":"","how":"birth"},{"q":"Q243075","name":"玛格丽特·林赛·哈金斯","desc":"","born":"1848年","died":"1915年","how":"work"},{"q":"Q1124735","name":"乔治·布伦特","desc":"","born":"1904年","died":"1979年","how":"work"}],"events":[{"q":"Q87186365","name":"2019冠状病毒病爱尔兰疫情","desc":"概述","year":"2020年"}]},"1429":{"desc":"愛爾蘭的郡","facts":{"capital":"特拉利","population":147707,"populationYear":"2016","area":4807},"wiki":"凯里郡","summary":"凯里郡（英语：County Kerry，爱尔兰语：Contae Chiarraí) 是爱尔兰的一个郡。它位于爱尔兰西南地区，属于明斯特省的一部分。它以居住在本县部分地区的恰雷格命名。凯里郡面积为4,746km²。2016年人口普查时，该郡人口有147,707人。 该郡首府为特拉利。","history":{"title":"历史","text":"凯里(爱尔兰语：Ciarraí 或在最初的爱尔兰语改革前拼写为Ciarraighe ) 表示“凯里人”，意思是本郡部分地区的古代盖尔部落。在传说中，部落的创始人是弗格斯·马克·罗伊的儿子凯尔（Ciar） 。 在古爱尔兰语中，“Ciar”的意思是黑色或深棕色，这个词在现代爱尔兰语中仍然用作形容词，描述深肤色。 爱尔兰语后缀raighe 的意思是人/部落 ，在爱尔兰的各种-ry地名中都可以找到，例如Osry是鹿人（Osraighe Deer-People/Tribe ）的简称。凯里郡的昵称为王国。\n1329 年 8 月 27 日，根据专利特许证 ，第一代戴斯蒙德伯爵莫里斯·菲茨杰拉德 被确认为整个克里郡帕拉廷的封建领主，对他和他的男性继承人来说，只需支付一名骑士的费用即可获得王位。"},"culture":{"title":"文化","text":"作为爱尔兰最边缘的一个地区，克里文化不易受外界影响，保留了爱尔兰语言以及爱尔兰传统音乐、歌曲和舞蹈。克里东北部的Sliabh Luachra地区与利默里克和科克接壤，以其传统音乐、舞蹈和歌曲而闻名，尤其是其波尔卡舞曲和小提琴演奏。 Tralee 的Siamsa Tíre中心是传统爱尔兰消遣的中心。 丁格尔半岛和Uíbh Ráthach被认为是爱尔兰语地区，爱尔兰文化在这些地区也非常强大。\n丁格尔半岛外的布拉斯基特群岛以其丰富的文学遗产而闻名。 佩格·赛尔斯 、 莫里斯·奥沙利文和托马斯·奥克罗汉等作家都写过关于岛上生活的书籍。这些岛屿于 1953 年因日益极端的天气条件而无法居住而被疏散。约翰·B·基恩是利斯维尔人，被认为是爱尔兰最伟大的剧作家之一，他的著名作品有《田野》 、 《赛弗》和Big Maggie 。"},"people":[{"q":"Q216129","name":"赫伯特·基奇纳，第一代基奇纳伯爵","desc":"","born":"1850年","died":"1916年","how":"birth"},{"q":"Q6187642","name":"杰茜·巴克利","desc":"","born":"1989年","died":"","how":"birth"},{"q":"Q208961","name":"布伦丹","desc":"","born":"486年","died":"577年","how":"birth"},{"q":"Q314917","name":"丹尼尔·欧康纳","desc":"","born":"1775年","died":"1847年","how":"birth"},{"q":"Q364975","name":"理查德·坎蒂隆","desc":"","born":"1675年","died":"1734年","how":"birth"},{"q":"Q470767","name":"汤姆·克林","desc":"","born":"1877年","died":"1938年","how":"birth"}],"events":[]},"1430":{"desc":"county in Ireland","facts":{"capital":"利默里克","population":195175,"populationYear":"2016","area":2756},"wiki":"利默里克郡","summary":"利默里克郡（County Limerick；爱尔兰语：Contae Luimnigh），是爱尔兰的一个郡，位于爱尔兰岛西南部，香农河在这里注入大西洋。历史上属芒斯特省。\n面积2,686 km²，2006年人口183,863人（包括首府利默里克，扣除后的人口为131,303人）。","people":[{"q":"Q541599","name":"多洛丝·奥瑞沃丹","desc":"","born":"1971年","died":"2018年","how":"birth"},{"q":"Q528826","name":"威廉·特雷弗","desc":"爱尔兰作家、剧作家（1928–2016）","born":"1928年","died":"2016年","how":"birth"},{"q":"Q455064","name":"约翰·弗拉纳根 (田径运动员)","desc":"","born":"1868年","died":"1938年","how":"birth"},{"q":"Q560476","name":"彼得·彼得罗维奇·拉西","desc":"","born":"1678年","died":"1751年","how":"birth"}],"events":[]},"1431":{"desc":"county in Ireland","facts":{"capital":"马达加斯加之战","population":64436,"populationYear":"2016","area":2548},"wiki":"羅斯康芒郡","summary":"罗斯康芒郡（County Roscommon；爱尔兰语：ContaeRos Comáin），是爱尔兰的一个郡，位于爱尔兰岛中部。历史上属康诺特省。\n面积2,547平方公里，截至2006年人口为58,700人。首府罗斯康芒。","people":[{"q":"Q236236","name":"奥立佛·高德史密斯","desc":"爱尔兰作家、诗人","born":"1728年","died":"1774年","how":"birth"},{"q":"Q237951","name":"德格拉斯·海德","desc":"","born":"1860年","died":"1949年","how":"birth"},{"q":"Q230084","name":"莫琳·奥沙利文","desc":"","born":"1911年","died":"1998年","how":"birth"},{"q":"Q933129","name":"克里斯·奥多德","desc":"","born":"1979年","died":"","how":"birth"},{"q":"Q965189","name":"埃蒙·坎特","desc":"","born":"1881年","died":"1916年","how":"birth"}],"events":[]},"1432":{"desc":"county in Ireland","facts":{"capital":"斯莱戈","population":65393,"populationYear":"2011","area":1838},"wiki":"斯萊戈郡","summary":"斯莱戈郡（County Sligo；爱尔兰语：Contae Shligigh），是爱尔兰的一个郡，位于爱尔兰岛西北海岸。历史上属康诺特省。斯莱戈是郡内行政首都以及最大的城镇。斯莱戈郡议会是当地政府部门。\n面积1,837平方公里，2022年人口70,198人。 此地以布尔本山闻名，是爱尔兰非常独特的自然景观。","history":{"title":"历史","text":"斯莱戈郡与1585年由爱尔兰副勋爵亨利·西德尼建立，但直到1603 年，九年战争的混乱结束才正式成立。"},"people":[{"q":"Q155907","name":"乔治·加布里埃尔·斯托克斯","desc":"英国数学家和物理学家","born":"1819年","died":"1903年","how":"birth"},{"q":"Q161154","name":"洛拉·蒙特兹","desc":"","born":"1821年","died":"1861年","how":"birth"},{"q":"Q55428","name":"尼尔·乔丹","desc":"爱尔兰导演、编剧","born":"1950年","died":"","how":"birth"},{"q":"Q767609","name":"尚恩·菲南","desc":"","born":"1979年","died":"","how":"birth"},{"q":"Q1775181","name":"马克·费海利","desc":"乐队“西城男孩”的其中一位成员","born":"1980年","died":"","how":"birth"},{"q":"Q598728","name":"奇恩·伊根","desc":"","born":"1980年","died":"","how":"birth"}],"events":[]},"1433":{"desc":"愛爾蘭的郡","facts":{"capital":"利福德","population":161137,"populationYear":"","area":4861},"wiki":"多尼戈爾郡","summary":"多尼戈尔郡（County Donegal；爱尔兰语：Contae Dhún na nGall），俗称County Tyrconnel（爱尔兰语：Tír Chonaill），是爱尔兰的一个郡，位于爱尔兰岛最北部。历史上属阿尔斯特省。在爱尔兰独立后，东邻北爱尔兰，仅靠与利特里姆郡的一小段边界与爱尔兰其他地区接壤。\n面积4,841平方公里，2006年人口146,956人。郡治利福德。多尼戈尔郡拥有爱尔兰各郡最长的海岸线，东北部的伊尼什欧文半岛是爱尔兰的最北端。","history":{"title":"历史","text":"多尼戈尔郡是曾经强盛的达拉氏族（Clann Dálaigh）的发源地，其最著名的分支是奥多奈尔氏族（Clann Ó Domhnaill），在英语中更为人熟知的名称是奥多奈尔王朝（O'Donnell dynasty）。直到1600年左右，奥多奈尔家族都是爱尔兰最富有、最有权势的本土统治家族之一。在阿尔斯特省内，只有蒂尔伊奥根（旧称蒂罗文，即今蒂龙郡）的奥尼尔家族（Uí Néill / O'Neills）比其更加强大。从13世纪初到17世纪初，奥多奈尔家族一直是阿尔斯特地区第二大势力氏族与统治家族。数个世纪以来，奥多奈尔家族统治着蒂尔康奈尔（Tír Chonaill/Tyrconnell）—— 这是阿尔斯特西部的一个盖尔王国，疆域几乎覆盖了如今的整个多尼戈尔郡。"},"culture":{"title":"文化","text":"多尼戈尔郡使用的爱尔兰语方言与苏格兰盖尔语有许多共同特征。多尼戈尔盖尔语区（爱尔兰语区）通行阿尔斯特方言，而伊尼肖文地区（部分区域直到20世纪初才改用英语）则使用东阿尔斯特方言。在多尼戈尔东部的芬谷与拉根区，人们也常使用阿尔斯特苏格兰语。多尼戈尔爱尔兰语对整个阿尔斯特地区的标准爱尔兰语教学影响深远。\n与爱尔兰西海岸其他地区一样，多尼戈尔郡部分地区拥有享誉世界的独特小提琴传统。该郡的民歌同样闻名，与器乐曲一样风格鲜明。以克兰纳德合唱团、帕特森一家、阿尔坦乐队以及独唱歌手恩雅为代表的多尼戈尔音乐人，凭借传统或带有传统风格的音乐在国际上大获成功。多尼戈尔音乐也影响了许多非本地出身的音乐人，包括民谣与流行歌手保罗·布雷迪和菲尔·科尔特。歌手丹尼尔·奥唐奈更是成为多尼戈尔广受欢迎的形象大使。"},"people":[{"q":"Q38257","name":"恩雅","desc":"爱尔兰歌手，词曲作者和音乐家","born":"1961年","died":"","how":"birth"},{"q":"Q21061212","name":"威廉·塞西尔·坎贝尔","desc":"","born":"1930年","died":"","how":"birth"},{"q":"Q236326","name":"圣高隆","desc":"","born":"521年","died":"597年","how":"birth"},{"q":"Q316724","name":"谢默斯·科尔曼","desc":"","born":"1988年","died":"","how":"birth"},{"q":"Q335820","name":"约翰·托兰德","desc":"爱尔兰哲学家、思想家（1670－1722）","born":"1670年","died":"1722年","how":"birth"},{"q":"Q331922","name":"洛瑞・盖勒许","desc":"","born":"1948年","died":"1995年","how":"birth"},{"q":"Q28114598","name":"艾米贝丝·麦克纳尔蒂","desc":"","born":"2001年","died":"","how":"birth"},{"q":"Q17520","name":"凯瑟琳·安东内利","desc":"","born":"1921年","died":"2006年","how":"birth"},{"q":"Q120132","name":"阿当南","desc":"","born":"624年","died":"704年","how":"birth"},{"q":"Q514544","name":"查理·麦基蒂根","desc":"","born":"1950年","died":"","how":"birth"},{"q":"Q371002","name":"帕基·邦纳","desc":"爱尔兰足球运动员","born":"1960年","died":"","how":"birth"}],"events":[]},"1434":{"desc":"county in Ireland","facts":{"capital":"香农河畔卡里克","population":35199,"populationYear":"2022","area":1590},"wiki":"利特里姆郡","summary":"利特里姆郡（County Leitrim；爱尔兰语：Contae Liatroma），是爱尔兰的一个郡，位于爱尔兰岛北部。其海岸线仅3公里长，又为艾伦湖和香农河划分为南北两半。历史上属康诺特省。郡名的意思是“灰色的山岭”。\n面积1,588平方公里，2006年人口28,837人，是爱尔兰人口最少的郡。首府香农河畔卡里克。","people":[{"q":"Q380182","name":"艾伯特·雷诺兹","desc":"前爱尔兰总理","born":"1932年","died":"2014年","how":"birth"},{"q":"Q3320941","name":"肖恩·麦克德莫特","desc":"","born":"1883年","died":"1916年","how":"birth"}],"events":[]},"1435":{"desc":"county in Ireland","facts":{"capital":"朗福德","population":40873,"populationYear":"2016","area":1091},"wiki":"朗福德郡","summary":"朗福德郡（County  Longford；爱尔兰语：Contae an Longfoirt），是爱尔兰的一个郡，位于爱尔兰岛中部。历史上属伦斯特省。西以香农河－里湖为界。\n面积1,091平方公里，2006年人口34,361人。首府朗福德。","people":[{"q":"Q355607","name":"弗朗西斯·伊西德罗·埃奇沃思","desc":"","born":"1845年","died":"1926年","how":"birth"},{"q":"Q373940","name":"亨利·休斯·威尔逊","desc":"","born":"1864年","died":"1922年","how":"birth"}],"events":[]},"1436":{"desc":"county in Ireland","facts":{"capital":"恩尼斯","population":117096,"populationYear":"2011","area":3450},"wiki":"克莱尔郡","summary":"克莱尔郡（County Clare；爱尔兰语：Contae an Chláir）是爱尔兰的一个郡，位于爱尔兰岛西岸，东以德格湖-香农河为界。历史上属芒斯特省。面积3,147平方公里。2011年人口117,196人。首府恩尼斯。","people":[{"q":"Q178225","name":"艾德纳·奥布赖恩","desc":"","born":"1930年","died":"2024年","how":"birth"},{"q":"Q310994","name":"帕特里克·希勒里","desc":"","born":"1923年","died":"2008年","how":"birth"},{"q":"Q21132821","name":"谢莉·麦克纳马拉","desc":"爱尔兰建筑师","born":"1952年","died":"","how":"birth"},{"q":"Q22006810","name":"莎拉·麦特南","desc":"","born":"1994年","died":"","how":"birth"},{"q":"Q1381503","name":"帕特·麦克唐纳","desc":"","born":"1878年","died":"1954年","how":"birth"},{"q":"Q5257674","name":"丹妮斯·高夫","desc":"","born":"1980年","died":"","how":"birth"},{"q":"Q247141","name":"威廉姆·史密斯·奥布莱恩","desc":"","born":"1803年","died":"1864年","how":"birth"},{"q":"Q960949","name":"约翰·荷兰","desc":"","born":"1840年","died":"1914年","how":"birth"}],"events":[]},"1437":{"desc":"爱尔兰的郡","facts":{"capital":"卡洛","population":56875,"populationYear":"2016","area":897},"wiki":"卡洛郡","summary":"卡洛郡（County Carlow；爱尔兰语：Contae Cheatharlach），是爱尔兰的一个郡，位于爱尔兰岛东南部。历史上属伦斯特省。绝大部分土地位于巴罗河以东。\n该郡面积896平方公里，2006年人口50,349人，首府卡洛。","people":[{"q":"Q360808","name":"约翰·廷德尔","desc":"爱尔兰物理学家（1820－1893）","born":"1820年","died":"1893年","how":"birth"},{"q":"Q332479","name":"尼古拉斯·艾尔沃德·维戈斯","desc":"","born":"1785年","died":"1840年","how":"birth"}],"events":[]},"1438":{"desc":"愛爾蘭的郡","facts":{"capital":"科克","population":584156,"populationYear":"2022","area":7500,"languages":["爱尔兰语","英语"]},"wiki":"科克郡","summary":"科克郡（英语：County Cork；爱尔兰语：Contae Chorcaí），俗称The Rebel County，是爱尔兰的一个郡，位于爱尔兰岛最南部。历史上属芒斯特省。\n面积7,457 km²，全国排名第一，2011年人口519,032人（包括首府科克，不包括科克的人口为399,802人）。","people":[{"q":"Q173196","name":"迈克尔·柯林斯","desc":"爱尔兰政治人物","born":"1890年","died":"1922年","how":"birth"},{"q":"Q231549","name":"安妮·伯妮","desc":"","born":"1697年","died":"","how":"birth"},{"q":"Q73612","name":"费欧娜·萧","desc":"","born":"1958年","died":"","how":"birth"},{"q":"Q6837191","name":"米歇尔·奥尼尔","desc":"","born":"1977年","died":"","how":"birth"},{"q":"Q2826927","name":"艾格尼兹·玛丽·克勒克","desc":"","born":"1842年","died":"1907年","how":"birth"},{"q":"Q237567","name":"索尼亚·奥沙利文","desc":"","born":"1969年","died":"","how":"birth"},{"q":"Q451693","name":"威廉·布朗克","desc":"","born":"1620年","died":"1684年","how":"birth"},{"q":"Q455053","name":"帕特·奥卡拉汉","desc":"","born":"1905年","died":"1991年","how":"birth"},{"q":"Q506000","name":"保罗·凯恩","desc":"","born":"1810年","died":"1871年","how":"birth"},{"q":"Q18045229","name":"保罗·欧唐诺凡","desc":"","born":"1994年","died":"","how":"birth"}],"events":[{"q":"Q208243","name":"1993年欧洲歌唱大赛","desc":"","year":"1993年"}]},"1439":{"desc":"county in Ireland","facts":{"capital":"卡旺","population":73183,"populationYear":"2011","area":1932},"wiki":"卡文郡","summary":"卡文郡 （County Cavan；爱尔兰语：Contae Chabháin）是爱尔兰的一个郡，位于爱尔兰岛东北部。历史上属阿尔斯特省。面积1,931平方公里，2006年人口63,961人。首府卡文。","people":[{"q":"Q440816","name":"肖恩·布雷迪","desc":"","born":"1939年","died":"","how":"birth"}],"events":[]}}}