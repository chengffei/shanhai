#include <metal_stdlib>
using namespace metal;

// 与 Swift 端 Uniforms 一致：只用 16 字节对齐的字段
struct Uniforms {
    float4x4 viewProj;
    float4x4 invViewProj;
    float4 eye;        // xyz
    float4 light;      // xyz
    float4 params;     // x 地形夸张（半径/米） y 省界透明度 z 国界透明度 w 风格：0 普通 1 地形 2 复古
    uint4  sel;        // 选中省、选中国、悬停省、悬停国
    float4 viewport;   // 宽、高（像素）、缩放、海拔（半径）
};

constant float PI = 3.14159265358979;

static int styleOf(constant Uniforms &u) { return int(u.params.w + 0.5); }
constant float3 ACCENT = float3(0.0, 0.48, 1.0);

static float3 spherePoint(float latr, float lonr) {
    float c = cos(latr);
    return float3(c * sin(lonr), sin(latr), c * cos(lonr));
}

static float heightAt(texture2d<float> heightTex, float2 uv) {
    constexpr sampler s(filter::linear, address::repeat);
    return max(heightTex.sample(s, uv, level(0)).r, 0.0);
}

// ---------- 地球 ----------
struct GlobeOut {
    float4 position [[position]];
    float2 uv;
    float3 normal;
    float3 world;
};



vertex GlobeOut globe_vertex(uint vid [[vertex_id]],
                             const device float2 *uvs [[buffer(0)]],
                             constant Uniforms &u [[buffer(1)]],
                             texture2d<float> heightTex [[texture(0)]]) {
    float2 uv = uvs[vid];
    float lonr = uv.x * 2.0 * PI - PI;
    float latr = PI * 0.5 - uv.y * PI;
    float3 n = spherePoint(latr, lonr);
    float r = 1.0 + heightAt(heightTex, uv) * u.params.x;
    GlobeOut o;
    o.position = u.viewProj * float4(n * r, 1.0);
    o.uv = uv;
    o.normal = n;
    o.world = n * r;
    return o;
}

fragment float4 globe_fragment(GlobeOut in [[stage_in]],
                               constant Uniforms &u [[buffer(1)]],
                               texture2d<float> base [[texture(0)]],
                               texture2d<uint> regionTex [[texture(1)]],
                               texture2d<uint> countryTex [[texture(2)]],
                               texture2d<float> heightTex [[texture(3)]]) {
    constexpr sampler s(filter::linear, mip_filter::linear, address::repeat, max_anisotropy(8));
    // 用 uv 的导数取 mip，经线接缝处 uv 跳变由网格重复列避免
    float3 color = base.sample(s, in.uv).rgb;

    uint w = regionTex.get_width(), h = regionTex.get_height();
    uint2 p = uint2(fract(in.uv.x) * w, clamp(in.uv.y, 0.0, 0.99999) * h);
    p.x = min(p.x, w - 1);
    uint rid = regionTex.read(p).r;
    uint cid = countryTex.read(p).r;

    float tint = 0.0;
    if (rid != 0 && rid == u.sel.x) tint = 0.38;
    else if (u.sel.x == 0 && cid != 0 && cid == u.sel.y) tint = 0.30;
    else if (u.sel.x != 0 && cid != 0 && cid == u.sel.y) tint = 0.08;
    if (tint == 0.0) {
        if (rid != 0 && rid == u.sel.z) tint = 0.16;
        else if (u.sel.z == 0 && cid != 0 && cid == u.sel.w) tint = 0.12;
    }
    // 复古风格用暖金高亮，蓝色压在棕色上会发闷
    int st = styleOf(u);
    float3 accent = st == 2 ? float3(1.0, 0.84, 0.55) : (st == 3 ? float3(1.0, 0.95, 0.80) : ACCENT);
    color = mix(color, accent, tint * (st >= 2 ? 1.3 : 1.0));

    float3 n = normalize(in.normal);
    float3 L = normalize(u.light.xyz);
    float d = max(dot(n, L), 0.0);
    int style = styleOf(u);
    if (style == 3) {
        // 黑金：陆地金箔（金属，高光带金色、边缘反射），海面钢琴漆（锐利白高光、边缘反暖光）
        float3 V = normalize(u.eye.xyz - in.world);
        float3 R = reflect(-L, n);
        float rv = max(dot(R, V), 0.0);
        float fres = pow(1.0 - saturate(dot(n, V)), 3.0);
        // 近看时球面接近平面，高光会铺满屏幕；按高度减弱
        float specK = smoothstep(0.15, 1.2, u.viewport.w);
        if (cid != 0) {
            float3 c = color * (0.38 + 0.58 * d);
            c += color * pow(rv, 6.0) * 0.28 * specK;                       // 宽的金色光泽
            c += float3(1.0, 0.92, 0.70) * pow(rv, 40.0) * 0.30 * specK;    // 窄的亮点
            c = mix(c, float3(0.50, 0.38, 0.18), fres * 0.35);              // 边缘偏暗金
            return float4(c, 1.0);
        }
        float3 c = color * (0.6 + 0.4 * d);
        c += float3(1.0, 0.97, 0.92) * pow(rv, 90.0) * 0.38 * specK;       // 漆面高光，柔一些
        c += float3(0.95, 0.80, 0.55) * pow(rv, 14.0) * 0.07 * specK;
        c += float3(0.55, 0.42, 0.25) * fres * 0.35;                        // 边缘映出暖色环境
        return float4(c, 1.0);
    }
    if (style == 2) {
        // 复古皮面：边缘压暗显出球体，加一层暖色柔光
        float3 V = normalize(u.eye.xyz - in.world);
        float rim = saturate(dot(n, V));
        float spec = pow(max(dot(reflect(-L, n), V), 0.0), 34.0) * 0.07;
        float shade = (0.70 + 0.38 * d) * (0.72 + 0.28 * rim);
        return float4(color * shade + float3(1.0, 0.86, 0.66) * spec, 1.0);
    }
    if (style == 1) {
        // 地形浮雕：晕渲 + 山体投影 + 环境光遮蔽，光源固定在西北、仰角 35°（制图惯例）
        constexpr sampler hs(filter::linear, address::repeat);
        float2 texel = 1.0 / float2(heightTex.get_width(), heightTex.get_height());
        float lat = PI * 0.5 - in.uv.y * PI;
        float coslat = max(cos(lat), 0.05);
        float lonr = in.uv.x * 2.0 * PI - PI;
        float3 east = float3(cos(lonr), 0.0, -sin(lonr));
        float3 north = cross(n, east);
        auto H = [&](float2 o) { return max(heightTex.sample(hs, in.uv + o).r, 0.0); };
        float h0 = H(float2(0));
        // 明暗用的放大倍数（半径/米）：顶点位移的 1.5 倍，最低 30 倍
        float k = max(u.params.x * 1.5, 30.0 / 6371000.0);

        // 1 晕渲：细（1 格）粗（6 格）两尺度坡度
        float3 nt = n;
        for (int lvl = 0; lvl < 2; lvl++) {
            float sstep = lvl == 0 ? 1.0 : 6.0;
            float w = lvl == 0 ? 0.45 : 0.55;
            float2 ox = float2(texel.x * sstep, 0), oy = float2(0, texel.y * sstep);
            float he = H(ox) - H(-ox);
            float hn = H(-oy) - H(oy);
            float dx = 2.0 * ox.x * 2.0 * PI * coslat;
            float dy = 2.0 * oy.y * PI;
            nt += w * (-east * (he * k / dx) - north * (hn * k / dy));
        }
        nt = normalize(nt);
        const float elev = 35.0 * PI / 180.0;
        float3 Ls = normalize(n * sin(elev) + (north - east) * (cos(elev) * 0.70710678));
        float hill = clamp(dot(nt, Ls) / dot(n, Ls), 0.0, 2.2);
        float relief = clamp(0.30 + 0.70 * hill, 0.48, 1.40);

        // 2 投影：沿光源水平方向往西北走，射线按仰角升高，被更高的地面挡住就在阴影里
        float shadow = 1.0;
        if (h0 < 8500.0) {
            float tanE = tan(elev);
            // 影子长度上限随视野缩短：近看时不让一道山的影子盖住半个盆地
            float dMax = min((8800.0 - h0) * k / tanE, min(0.035, u.viewport.w * 0.06));
            float2 dirUV = float2(-0.70710678 / (2.0 * PI * coslat), -0.70710678 / PI);
            for (int i = 1; i <= 16; i++) {
                float t = float(i) / 16.0;
                float D = dMax * t * t;
                float rayH = h0 + D * tanE / k;
                float diff = H(dirUV * D) - rayH;
                shadow = min(shadow, 1.0 - smoothstep(0.0, 350.0, diff));
            }
        }

        // 3 环境光遮蔽：比周围两圈平均海拔低的地方（谷底、盆地）压暗
        float ring1 = 0.0, ring2 = 0.0;
        for (int j = 0; j < 8; j++) {
            float a = float(j) * PI * 0.25;
            float2 dir = float2(cos(a) / coslat * texel.y * 2.0, sin(a) * texel.y);
            ring1 += H(dir * 4.0);
            ring2 += H(dir * 14.0);
        }
        float around = (ring1 + ring2) / 16.0;
        float ao = clamp(1.0 - (around - h0) / 2600.0, 0.6, 1.08);

        // 4 海拔亮度：高原略亮、平原盆地略暗
        float alt = mix(0.93, 1.08, smoothstep(0.0, 4500.0, h0));
        float land = step(1.0, h0);
        float3 lit = color * (0.62 + 0.45 * d);
        float3 emboss = lit * relief * alt * ao * mix(0.62, 1.0, shadow);
        return float4(mix(lit, emboss, land), 1.0);
    }
    float shade = 0.86 + 0.16 * d;
    return float4(color * shade, 1.0);
}

// ---------- 边界线 ----------
struct LineOut {
    float4 position [[position]];
};

constant float2 OFFSETS[9] = { float2(0,0), float2(1,0), float2(0,1), float2(1,1), float2(-1,0), float2(0,-1), float2(-1,-1), float2(1,-1), float2(-1,1) };

vertex LineOut line_vertex(uint vid [[vertex_id]],
                           uint iid [[instance_id]],
                           const device float2 *lonlat [[buffer(0)]],
                           constant Uniforms &u [[buffer(1)]],
                           texture2d<float> heightTex [[texture(0)]]) {
    float2 ll = lonlat[vid];
    float lonr = ll.x * PI / 180.0, latr = ll.y * PI / 180.0;
    float2 uv = float2((ll.x + 180.0) / 360.0, (90.0 - ll.y) / 180.0);
    float3 n = spherePoint(latr, lonr);
    float3 p = n * (1.0 + heightAt(heightTex, uv) * u.params.x);
    p += n * distance(p, u.eye.xyz) * 0.0015;     // 抬离地表，避免与地面互相遮挡
    LineOut o;
    o.position = u.viewProj * float4(p, 1.0);
    o.position.xy += OFFSETS[iid] * 2.0 / u.viewport.xy * o.position.w;
    return o;
}

fragment float4 line_fragment(LineOut in [[stage_in]], constant float4 &color [[buffer(0)]]) {
    return float4(color.rgb * color.a, color.a);
}

// ---------- 大气与背景 ----------
struct SkyOut {
    float4 position [[position]];
    float2 ndc;
};

vertex SkyOut sky_vertex(uint vid [[vertex_id]]) {
    float2 p = float2((vid << 1) & 2, vid & 2) * 2.0 - 1.0;
    SkyOut o;
    o.position = float4(p, 1.0, 1.0);
    o.ndc = p;
    return o;
}

fragment float4 sky_fragment(SkyOut in [[stage_in]], constant Uniforms &u [[buffer(1)]]) {
    float4 a = u.invViewProj * float4(in.ndc, 0.0, 1.0);
    float4 b = u.invViewProj * float4(in.ndc, 1.0, 1.0);
    float3 ro = u.eye.xyz;
    float3 rd = normalize(b.xyz / b.w - a.xyz / a.w);
    float t = max(-dot(ro, rd), 0.0);
    float closest = length(ro + rd * t);
    if (styleOf(u) == 3) {
        // 黑金：深暖黑，球后一圈很淡的暖光把球托出来
        float4 a3 = u.invViewProj * float4(in.ndc, 0.0, 1.0);
        float4 b3 = u.invViewProj * float4(in.ndc, 1.0, 1.0);
        float3 rd3 = normalize(b3.xyz / b3.w - a3.xyz / a3.w);
        float t3 = max(-dot(u.eye.xyz, rd3), 0.0);
        float cl = length(u.eye.xyz + rd3 * t3);
        float halo = exp(-max(cl - 1.0, 0.0) * 3.5);
        float v = 1.0 - 0.18 * dot(in.ndc, in.ndc);
        return float4((float3(0.045, 0.038, 0.032) + float3(0.20, 0.14, 0.07) * halo * 0.55) * v, 1.0);
    }
    if (styleOf(u) == 2) {
        // 复古：暖灰桌面，四角微暗，不画大气光晕
        float v = 1.0 - 0.10 * dot(in.ndc, in.ndc);
        return float4(float3(0.87, 0.85, 0.82) * v, 1.0);
    }
    float3 space = float3(0.035, 0.045, 0.075);
    float glow = 1.0 - smoothstep(1.0, 1.0 + 0.045, closest);
    glow = pow(glow, 1.8);
    float3 c = space + float3(0.45, 0.68, 1.0) * glow * 0.55;
    return float4(c, 1.0);
}

// ---------- 地名标签 ----------
struct LabelInstance {
    float2 center;    // 像素（左上原点）
    float2 size;      // 像素
    float4 uv;        // x0 y0 x1 y1
    float4 style;     // x 0 = 省 1 = 国；y 不透明度
};

struct LabelOut {
    float4 position [[position]];
    float2 uv;
    float kind;
    float alpha;
    float onLand;
};

vertex LabelOut label_vertex(uint vid [[vertex_id]], uint iid [[instance_id]],
                             const device LabelInstance *ls [[buffer(0)]],
                             constant Uniforms &u [[buffer(1)]]) {
    LabelInstance l = ls[iid];
    float2 corner = float2(vid & 1, vid >> 1);            // 三角带 4 个顶点
    float2 px = l.center + (corner - 0.5) * l.size;
    LabelOut o;
    o.position = float4(px.x / u.viewport.x * 2.0 - 1.0, 1.0 - px.y / u.viewport.y * 2.0, 0.0, 1.0);
    o.uv = mix(l.uv.xy, l.uv.zw, corner);
    o.kind = l.style.x;
    o.alpha = l.style.y;
    o.onLand = l.style.z;
    return o;
}

fragment float4 label_fragment(LabelOut in [[stage_in]], constant Uniforms &u [[buffer(1)]],
                               texture2d<float> atlas [[texture(0)]]) {
    constexpr sampler s(filter::linear);
    float2 fh = atlas.sample(s, in.uv).rg;
    int style = styleOf(u);
    bool terrain = style == 1;
    // kind：0 省 1 国 2 城市 3 海洋
    // 国名深灰、城市近墨、省名中灰；白边略透，不压底图
    // 地形：国名、城市纯白，省名退一档成浅灰白；深色白边加重到 0.62，冰原、沙漠上也托得住
    float3 ink = terrain ? (in.kind > 0.5 ? float3(1.0) : float3(0.84, 0.86, 0.88))
                         : (in.kind > 1.5 ? float3(0.17, 0.17, 0.19) : (in.kind > 0.5 ? float3(0.26, 0.26, 0.29) : float3(0.43, 0.43, 0.46)));
    float3 halo = terrain ? float3(0.02, 0.04, 0.06) : float3(1.0, 0.995, 0.985);
    float haloA = terrain ? 0.78 : 0.72;
    if (style == 2) {
        // 复古：陆地上奶油色字配深棕描边（像烫印）；海上深棕字配焦糖描边；省名退一档
        if (in.onLand > 0.5) {
            ink = in.kind > 0.5 ? float3(0.98, 0.90, 0.76) : float3(0.90, 0.78, 0.62);
            halo = float3(0.24, 0.12, 0.06);
        } else {
            ink = float3(0.30, 0.15, 0.06);
            halo = float3(0.86, 0.62, 0.38);
        }
        haloA = 0.55;
    }
    if (style == 3) {
        // 黑金：金面上深墨字配金色描边；黑海上反过来，金字配黑描边
        if (in.onLand > 0.5) {
            ink = in.kind > 0.5 ? float3(0.10, 0.07, 0.02) : float3(0.20, 0.14, 0.05);
            halo = float3(0.86, 0.70, 0.38);
        } else {
            ink = float3(0.90, 0.74, 0.42);
            halo = float3(0.02, 0.02, 0.02);
        }
        haloA = 0.6;
    }
    if (in.kind > 2.5) {
        // 海洋名：不要白边，颜色贴着海面
        ink = style == 3 ? float3(0.86, 0.70, 0.40) : (style == 2 ? float3(0.42, 0.22, 0.10) : (terrain ? float3(0.70, 0.82, 0.94) : float3(0.30, 0.46, 0.60)));
        haloA = 0.0;
    }
    float a = max(fh.r, fh.g * haloA);
    float3 c = mix(halo, ink, fh.r / max(a, 1e-4) * (fh.r > 0.0 ? 1.0 : 0.0));
    a *= in.alpha;
    return float4(c * a, a);
}
