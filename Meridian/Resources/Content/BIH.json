birth"},{"q":"Q4893443","name":"塞米兹·阿里·帕夏","desc":"","born":"1513年","died":"1565年","how":"birth"},{"q":"Q1528131","name":"哈迪姆·锡南·帕夏","desc":"","born":"1459年","died":"1517年","how":"birth"}],"events":[]},"425":{"desc":"波黑实体之一波黑联邦的州份","facts":{"capital":"奥拉谢","population":48089,"populationYear":"2013","area":325},"wiki":"波薩維納州","summary":"波萨维纳州（克罗地亚语：Županija Posavska，波斯尼亚语：Posavski kanton，塞尔维亚语：Посавски кантон），是波斯尼亚和黑塞哥维那实体之一波黑联邦的州份，位于该国北部。此州面积为330.85平方公里，为十州中面积最小的州份。2013年人口数量为43,453人。此州为波黑联邦的外飞地，南边为塞族共和国和布尔奇科特区，北边为萨瓦河和克罗地亚。州府为奥拉谢，最大城市为奥扎克。","people":[{"q":"Q183848","name":"阿利雅·伊泽特贝戈维奇","desc":"","born":"1925年","died":"2003年","how":"birth"},{"q":"Q157131","name":"佐兰·金吉奇","desc":"塞尔维亚政治人物，前总理","born":"1952年","died":"2003年","how":"birth"},{"q":"Q496071","name":"马托·内雷特利亚克","desc":"克罗地亚足球运动员","born":"1979年","died":"","how":"birth"},{"q":"Q358718","name":"柳普科·彼德洛维奇","desc":"","born":"1947年","died":"","how":"birth"},{"q":"Q361173","name":"苏莱曼·蒂希奇","desc":"","born":"1951年","died":"2014年","how":"birth"}],"events":[]},"426":{"desc":"","facts":{},"people":[{"q":"Q206306","name":"韦德兰·乔尔卢卡","desc":"克罗地亚足球运动员","born":"1986年","died":"","how":"birth"},{"q":"Q26309","name":"阿米尔·卡里奇","desc":"斯洛文尼亚足球运动员","born":"1973年","died":"","how":"birth"},{"q":"Q2700323","name":"奥格年·库兹米奇","desc":"塞尔维亚篮球运动员","born":"1990年","died":"","how":"birth"},{"q":"Q549848","name":"托杰","desc":"克罗地亚足球运动员","born":"1975年","died":"","how":"birth"},{"q":"Q267822","name":"英迪拉·拉迪奇","desc":"","born":"1966年","died":"","how":"birth"},{"q":"Q350384","name":"米兰·耶利奇","desc":"","born":"1956年","died":"2007年","how":"birth"},{"q":"Q470649","name":"鲍里斯拉夫·帕拉瓦茨","desc":"","born":"1943年","died":"2026年","how":"birth"},{"q":"Q715706","name":"亚历山大·杜里奇","desc":"","born":"1970年","died":"","how":"birth"}],"events":[]},"427":{"desc":"","facts":{},"people":[{"q":"Q335688","name":"米洛拉德·多迪克","desc":"波黑政治人物","born":"1959年","died":"","how":"birth"},{"q":"Q161038","name":"内文·苏博蒂奇","desc":"塞尔维亚男子足球运动员","born":"1988年","died":"","how":"birth"},{"q":"Q510462","name":"约西普·伊利西奇","desc":"","born":"1988年","died":"","how":"birth"},{"q":"Q261095","name":"伊万·留比契奇","desc":"克罗地亚网球运动员","born":"1979年","died":"","how":"birth"},{"q":"Q96182876","name":"乔沃·卢基奇","desc":"","born":"1998年","died":"","how":"birth"},{"q":"Q506570","name":"温科·普利奇","desc":"","born":"1945年","died":"","how":"birth"},{"q":"Q277282","name":"莱帕·拉迪奇","desc":"","born":"1925年","died":"1943年","how":"birth"},{"q":"Q715945","name":"佩塔尔·科契奇","desc":"","born":"1877年","died":"1916年","how":"birth"},{"q":"Q235875","name":"玛丽亚·塞斯蒂奇","desc":"","born":"1987年","died":"","how":"birth"},{"q":"Q458781","name":"埃尔丁·贾库波维奇","desc":"","born":"1984年","died":"","how":"birth"},{"q":"Q16211837","name":"斯尔詹·巴比奇","desc":"塞尔维亚男子足球运动员","born":"1996年","died":"","how":"birth"},{"q":"Q12752078","name":"佐兰·泰盖尔蒂亚","desc":"波黑塞尔维亚族政治人物","born":"1961年","died":"","how":"birth"}],"events":[]},"428":{"desc":"波黑的自治特区","facts":{"capital":"布尔奇科","population":83516,"populationYear":"2013","area":493},"wiki":"布爾奇科特區","summary":"布尔奇科特区（波斯尼亚语：Brčko distrikt，塞尔维亚语：Брчко дистрикт，克罗地亚语：Brčko distrikt），是波斯尼亚和黑塞哥维那东北部的一个自治行政单位。法律上是波斯尼亚和黑塞哥维那联邦和塞族共和国的共管区域，设立于1999年，于2000年3月8日起正式运作。共管的起因是布尔奇科及其周边区域的民族多样性及其在新近独立国家波黑内的特殊地位。实际上它是以一个自治地方政府的形式来运作的，如同波黑的其他市镇一样。\n布尔奇科特区的面积为493平方公里，2013年人口数量为83,516人。行政中心为布尔奇科。","history":{"title":"历史","text":"布尔奇科特区是在国际社会驻波黑高级代表进行仲裁程序后建立的。然而，根据《代顿协议》，该进程只能对实体间边界线（IEBL）的争议部分进行仲裁。布尔奇科区由前布尔奇科市的整个领土组成，其中48%（包括布尔奇科城）位于新成立的塞族共和国，52%位于旧的波斯尼亚和黑塞哥维那联邦。\n布尔奇科是当时《代顿协议》中唯一尚未最终确定的内容。仲裁协议后来于1999年3月最终确定，由此产生了一个由美国布尔奇科国际监督员管理的“地区”。自2006年以来，首席副高级代表接管了布尔奇科监督员的职责。\n20世纪90年代，亚利桑那市场在执行部队（IFOR）南北“亚利桑那”公路和东西波萨维纳走廊公路的交汇处创建，与今天的地区接壤，并取得了商业上的成功。\n第一位布尔奇科国际监督员于1997年4月抵达。"},"people":[{"q":"Q466435","name":"维斯纳·皮萨罗维奇","desc":"","born":"1978年","died":"","how":"birth"}],"events":[]},"429":{"desc":"","facts":{},"people":[{"q":"Q240456","name":"萨沃·米洛舍维奇","desc":"塞尔维亚足球运动员","born":"1973年","died":"","how":"birth"},{"q":"Q11835083","name":"罗多柳布·罗基·武洛维奇","desc":"","born":"1955年","died":"","how":"birth"},{"q":"Q4638