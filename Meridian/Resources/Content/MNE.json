apital":"新海尔采格","population":30690,"populationYear":"2017","area":235},"wiki":"新海爾采格市鎮","summary":"新海尔采格市镇（黑山语：Opština Herceg Novi）是黑山的24个市镇之一，位于该国西部，行政中心为新海尔采格，面积235平方公里，2011年人口30,864，人口密度每平方公里130人。","people":[{"q":"Q1312312","name":"海尔塞克利·艾哈迈德帕夏","desc":"","born":"1456年","died":"1517年","how":"birth"}],"events":[{"q":"Q2621537","name":"卡斯泰尔诺沃之围","desc":"","year":"1539年"}]},"2293":{"desc":"黑山的市镇","facts":{"capital":"科托尔","population":21916,"populationYear":"2023","area":335},"wiki":"科托爾市鎮","summary":"科托尔市镇（黑山语：Opština Kotor / Општина Котор）是黑山的24个市镇之一，位于该国南部，行政中心为科托尔，面积335平方公里，2011年人口22,601，人口密度每平方公里67人。科托尔是一座位于科托尔峡湾深处的古城，古城的地势前临峡湾，背倚悬崖，由于它保留了16～17世纪的古建筑群及完整城墙，且城墙是巧妙地利用悬崖地形，构筑而成的三层防御系统，而列入联合国世界文化遗产名录。古城还于2019年获选为欧洲年度最佳旅游目的地。古城前方的峡湾码头可停泊2000人级的大型邮轮，此处是地中海东侧邮轮游程的重要景点。","people":[{"q":"Q149074","name":"兰保·阿玛德乌斯","desc":"","born":"1963年","died":"","how":"birth"},{"q":"Q247041","name":"内纳德·马斯洛瓦","desc":"","born":"1967年","died":"","how":"birth"},{"q":"Q431413","name":"斯韦托扎尔·马罗维奇","desc":"","born":"1955年","died":"","how":"birth"},{"q":"Q764012","name":"托米斯拉夫·克恩科维奇","desc":"","born":"1929年","died":"2009年","how":"birth"},{"q":"Q159114","name":"拉多拉·盖达","desc":"","born":"1892年","died":"1948年","how":"birth"}],"events":[]},"2294":{"desc":"黑山的市镇","facts":{"capital":"安德里耶维察","population":4790,"populationYear":"2017","area":340},"wiki":"安德里耶維察市鎮","summary":"安德里耶维察市镇（黑山语：Opština Andrijevica），是黑山的市镇之一，位于该国东北部，行政中心为安德里耶维察，面积340平方公里，2011年人口5,071，人口密度每平方公里15人。","people":[],"events":[]},"2295":{"desc":"黑山的市镇","facts":{"capital":"贝拉内","population":27256,"populationYear":"2017","area":717},"wiki":"貝拉內市鎮","summary":"贝拉内市镇（黑山语：Opština Berane / Општина Беране），是黑山的24个市镇之一，位于该国东北部，行政中心为贝拉内，面积544平方公里，2011年人口33,970，人口密度每平方公里62人。","people":[{"q":"Q316751","name":"迪拿高斯拉夫·积域","desc":"","born":"1974年","died":"","how":"birth"},{"q":"Q452907","name":"马娅·萨维奇","desc":"","born":"1976年","died":"","how":"birth"},{"q":"Q1333510","name":"埃尔萨德·兹维罗蒂奇","desc":"","born":"1986年","died":"","how":"birth"},{"q":"Q57